# Script mode: cmake -DOUTPUT=<file.cpp> -DHEADER=<include> -DFUNCTION=<name> -DFILES=<a|b|...> [-DNAMESPACE=<ns>] -P EmbedText.cmake
# Writes a C++ file whose FUNCTION(name) returns the text of the file with that base name, or an empty view.

if(NOT NAMESPACE)
    set(NAMESPACE "freetvc::debug")
endif()
string(REPLACE "|" ";" FILES "${FILES}")
set(body "")
set(lookup "")
set(index 0)
foreach(path IN LISTS FILES)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    get_filename_component(name "${path}" NAME)
    string(APPEND body "const unsigned char k${index}[] = {${hex}0};\n")
    string(APPEND lookup "    if (name == \"${name}\") {\n        return {reinterpret_cast<const char*>(k${index}), sizeof k${index} - 1};\n    }\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}.tmp" "// Generated by cmake/EmbedText.cmake; do not edit.
#include \"${HEADER}\"

namespace ${NAMESPACE} {

namespace {

${body}
}  // namespace

std::string_view ${FUNCTION}(std::string_view name) {
${lookup}    return {};
}

}  // namespace ${NAMESPACE}
")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
