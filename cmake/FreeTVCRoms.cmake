# ROM autofetch (design/build.md "ROM autofetch"): the pieces and images of data/roms.txt, pinned by SHA-256.
# FREETVC_FETCH_ROMS=ON copies them as roms/ next to the programs, where the ROM search looks;
# `cmake -DFREETVC_ROM_OUT=<dir> -P cmake/FreeTVCRoms.cmake` fills any folder. freeTVC's --fetch-roms reads the same list.

set(FREETVC_ROM_LIST "${CMAKE_CURRENT_LIST_DIR}/../data/roms.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FREETVC_ROM_LIST}")

# Downloads the list's pieces into `cache`, joins them into its images in `out` and writes the notice
function(freetvc_fetch_roms cache out)
    file(STRINGS "${FREETVC_ROM_LIST}" lines ENCODING UTF-8)
    set(site "")
    set(pieces "")
    set(images "")
    set(notice "")
    foreach(line IN LISTS lines)
        if(line MATCHES "^site (.+)$")
            set(site "${CMAKE_MATCH_1}")
        elseif(line MATCHES "^piece ([^ ]+) ([^ ]+) ([0-9a-f]+)$")
            list(APPEND pieces "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_3}")
        elseif(line MATCHES "^image ([^ ]+) ([^ ]+) ([0-9a-f]+) ([0-9A-F]+) (.+)$")
            list(APPEND images "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_3}|${CMAKE_MATCH_4}|${CMAKE_MATCH_5}")
        elseif(line MATCHES "^notice (.*)$")
            string(APPEND notice "${CMAKE_MATCH_1}\n")
        endif()
    endforeach()
    file(MAKE_DIRECTORY "${cache}" "${out}")

    foreach(entry IN LISTS pieces)
        string(REPLACE "|" ";" parts "${entry}")
        list(GET parts 0 name)
        list(GET parts 1 path)
        list(GET parts 2 sha)
        set(dest "${cache}/${name}")
        if(EXISTS "${dest}")
            file(SHA256 "${dest}" have)
            if(have STREQUAL sha)
                continue()
            endif()
        endif()
        set(url "${site}/${path}")
        if(path MATCHES "^https://")
            set(url "${path}")
        endif()
        # The site's certificate chain is incomplete, so the pinned SHA-256 vouches for the file, not TLS
        file(DOWNLOAD "${url}" "${dest}" TLS_VERIFY OFF EXPECTED_HASH SHA256=${sha} STATUS status)
        list(GET status 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${dest}")
            message(FATAL_ERROR "ROM download failed: ${url}: ${status}")
        endif()
    endforeach()

    string(APPEND notice "\nfile          CRC-32    what, and the files on ${site} (in socket order)\n")
    foreach(entry IN LISTS images)
        string(REPLACE "|" ";" parts "${entry}")
        list(GET parts 0 name)
        list(GET parts 1 joined)
        list(GET parts 2 sha)
        list(GET parts 3 crc)
        list(GET parts 4 what)
        set(dest "${out}/${name}")
        string(REPLACE "+" ";" sources "${joined}")
        set(paths "")
        set(origins "")
        foreach(piece IN LISTS sources)
            # ARCHIVE#MEMBER: a file inside a downloaded ZIP, unpacked next to it
            set(member "")
            if(piece MATCHES "^([^#]+)#(.+)$")
                set(piece "${CMAKE_MATCH_1}")
                set(member "${CMAKE_MATCH_2}")
                file(ARCHIVE_EXTRACT INPUT "${cache}/${piece}" DESTINATION "${cache}/${piece}.d" PATTERNS "${member}")
                list(APPEND paths "${cache}/${piece}.d/${member}")
            else()
                list(APPEND paths "${cache}/${piece}")
            endif()
            foreach(p IN LISTS pieces)
                if(p MATCHES "^${piece}\\|([^|]*)\\|")
                    if(member STREQUAL "")
                        list(APPEND origins "${CMAKE_MATCH_1}")
                    else()
                        list(APPEND origins "${CMAKE_MATCH_1} (${member})")
                    endif()
                endif()
            endforeach()
        endforeach()
        set(have "")
        if(EXISTS "${dest}")
            file(SHA256 "${dest}" have)
        endif()
        if(NOT have STREQUAL sha)
            execute_process(COMMAND ${CMAKE_COMMAND} -E cat ${paths} OUTPUT_FILE "${dest}" RESULT_VARIABLE rc)
            file(SHA256 "${dest}" have)
            if(NOT rc EQUAL 0 OR NOT have STREQUAL sha)
                file(REMOVE "${dest}")
                message(FATAL_ERROR "ROM ${name}: joining ${joined} gave SHA-256 ${have}, expected ${sha}")
            endif()
        endif()
        string(REPLACE ";" " + " origins "${origins}")
        string(LENGTH "${name}" length)
        math(EXPR pad "14 - ${length}")
        if(pad LESS 1)
            set(pad 1)
        endif()
        string(REPEAT " " ${pad} spaces)
        string(APPEND notice "${name}${spaces}${crc}  ${what}: ${origins}\n")
    endforeach()
    file(WRITE "${out}/ROMS-README.txt" "${notice}")
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT FREETVC_ROM_OUT)
        message(FATAL_ERROR "usage: cmake -DFREETVC_ROM_OUT=<dir> -P cmake/FreeTVCRoms.cmake")
    endif()
    freetvc_fetch_roms("${FREETVC_ROM_OUT}/downloads" "${FREETVC_ROM_OUT}")
    file(REMOVE_RECURSE "${FREETVC_ROM_OUT}/downloads")
    message(STATUS "TVC ROMs in ${FREETVC_ROM_OUT}")
else()
    set(FREETVC_ROMS_STAGE "${CMAKE_BINARY_DIR}/roms")
    freetvc_fetch_roms("${CMAKE_BINARY_DIR}/rom-downloads" "${FREETVC_ROMS_STAGE}")
endif()
