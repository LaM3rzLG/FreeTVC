index 0000000..ded1004
--- /dev/null
+++ b/tests/dzrpgenericremote.tests.ts
@@ -0,0 +1,102 @@
+import * as assert from 'assert';
+import * as sinon from 'sinon';
+import {suite, test, setup, teardown} from 'mocha';
+import {WorkspacePaths} from '../src/misc/workspacepaths';
+import {Settings} from '../src/settings/settings';
+import {DzrpGenericSocketRemote} from '../src/remotes/dzrptransport/dzrpgenericremote';
+import {BankType} from '../src/remotes/MemoryModel/memorymodel';
+
+
+
+suite('DzrpGenericRemote', () => {
+
+	setup(() => {
+		WorkspacePaths.setExtensionPath('.');
+	});
+
+	teardown(() => {
+		sinon.restore();
+	});
+
+	suite('createCustomMemoryModel', () => {
+
+		test('customMemory with hex strings and a bank in slots of different sizes', () => {
+			const cfg: any = {
+				remoteType: 'dzrp',
+				rootFolder: './tests/data',
+				dzrp: {
+					customMemory: {
+						slots: [
+							{
+								range: ["0x0000", "0x3FFF"],
+								banks: [{index: 0, name: "ROM", rom: true}, {index: 1, name: "RAM0"}]
+							},
+							{
+								range: ["0x4000", "0xBFFF"],
+								banks: [{index: 2, name: "RAM1"}]
+							},
+							{
+								range: ["0xC000", "0xDFFF"],
+								banks: [{index: 0, bankSize: "0x4000"}, {index: 3, name: "RAM2"}]
+							},
+							{
+								range: ["0xE000", "0xFFFF"],
+								initialBank: 4,
+								banks: [{index: 0, bankSize: "0x4000", bankOffset: "0x2000"}, {index: 4, name: "RAM3"}]
+							}
+						]
+					}
+				}
+			};
+			Settings.launch = Settings.Init(cfg);
+			Settings.CheckSettings();
+			const remote = new DzrpGenericSocketRemote(Settings.launch.dzrp) as any;
+			const model = remote.createCustomMemoryModel();
+
+			assert.equal(model.slotRanges.length, 4);
+			assert.equal(model.slotRanges[2].start, 0xC000);
+			assert.equal(model.slotRanges[3].end, 0xFFFF);
+			assert.deepEqual(model.initialSlots, [0, 2, 0, 4]);
+			assert.equal(model.slotAddress64kAssociation[0xE000], 3);
+			assert.equal(model.banks[0].name, "ROM");
+			assert.equal(model.banks[0].bankType, BankType.ROM);
+			assert.equal(model.banks[0].size, 0x4000);
+			assert.deepEqual(model.banks[0].slotBankOffsets, {3: 0x2000});
+			assert.equal(model.banks[2].size, 0x8000);
+			assert.equal(model.banks[4].name, "RAM3");
+			assert.equal(model.getBankName(3), "RAM2");
+		});
+
+		test('no customMemory', () => {
+			const cfg: any = {
+				remoteType: 'dzrp',
+				rootFolder: './tests/data'
+			};
+			Settings.launch = Settings.Init(cfg);
+			const remote = new DzrpGenericSocketRemote(Settings.launch.dzrp) as any;
+			assert.throws(() => remote.createCustomMemoryModel(), /customMemory/);
+		});
+	});
+
+	suite('enableBreakOnInterrupt', () => {
+
+		test('supported', async () => {
+			Settings.launch = Settings.Init({remoteType: 'dzrp', rootFolder: './tests/data'} as any);
+			const remote = new DzrpGenericSocketRemote(Settings.launch.dzrp) as any;
+			remote.supportsBreakOnInterrupt = true;
+			const send = sinon.stub(remote, 'sendDzrpCmdEnableBreakOnInterrupt').resolves();
+			assert.equal(await remote.enableBreakOnInterrupt(true), true);
+			assert.equal(await remote.enableBreakOnInterrupt(false), false);
+			assert.deepEqual(send.args, [[true], [false]]);
+		});
+
+		test('not supported', async () => {
+			Settings.launch = Settings.Init({remoteType: 'dzrp', rootFolder: './tests/data'} as any);
+			const remote = new DzrpGenericSocketRemote(Settings.launch.dzrp) as any;
+			remote.supportsBreakOnInterrupt = false;
+			const send = sinon.stub(remote, 'sendDzrpCmdEnableBreakOnInterrupt').resolves();
+			assert.equal(await remote.enableBreakOnInterrupt(true), false);
+			assert.ok(send.notCalled);
+		});
+	});
+});
