+	/** Converts the hex strings of a 'customMemory' (zsim or dzrp) into
+	 * numbers, the file paths into absolute paths and sets the defaults.
+	 * @param custMem The custom memory definition. Nothing is done if undefined.
+	 * @param rootFolder The folder for relative file paths.
+	 */
+	protected static convertCustomMemory(custMem: CustomMemoryType | undefined, rootFolder: string) {
+		if (custMem === undefined)
+			return;
+		// io MMU concatenate
+		if (custMem.ioMmu !== undefined) {
+			if (typeof custMem.ioMmu !== "string")
+				custMem.ioMmu = custMem.ioMmu.join("\n");
+		}
+		// Slots
+		for (const slotRange of custMem.slots) {
+			// Convert slot ranges from hex-string to number
+			const len = slotRange.range.length;
+			for (let i = 0; i < len; i++) {
+				// Convert hex into number
+				slotRange.range[i] = HexFormat.convertHexNumber(slotRange.range[i])!;
+			}
+			// Banks
+			for (const bank of slotRange.banks) {
+				// ROM/RAM
+				if (bank.rom === undefined)
+					bank.rom = false;	// RAM by default;
+				// Create abs paths
+				if (bank.filePath) {
+					const path = UnifiedPath.getUnifiedPath(bank.filePath);
+					bank.filePath = WorkspacePaths.getAbsFilePath(path, rootFolder);
+				}
+				// Convert rom offset, bank size and bank offset from hex-string to number
+				bank.fileOffset = HexFormat.convertHexNumber(bank.fileOffset);
+				bank.bankSize = HexFormat.convertHexNumber(bank.bankSize);
+				bank.bankOffset = HexFormat.convertHexNumber(bank.bankOffset);
+			}
+		}
+	}
+
+
