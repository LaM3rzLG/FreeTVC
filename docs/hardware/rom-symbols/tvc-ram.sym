; freeTVC symbols: OS and BASIC RAM in U0 (page 0 after boot), all ROM versions unless noted
; Format: label = 0xADDR  ; comment   (plain format, docs/design/debug-and-remote.md)
; Names: [OS] appendix 23 (PDF p. 160-161); evidence and ROM sites: docs/hardware/rom.md
; Tag "2.2" = referenced by the SYS 2.2 / EXT 2.x code (z80trace immediates or jump targets)

P_SAVE        = 0x0003  ; paging shadow of port 02h; 2.2
RST08_ERROR   = 0x0008  ; BASIC: raise error n (inline byte); copied from F7B4h by BASIC init; 2.2
RST10_ERRNZ   = 0x0010  ; BASIC: RET Z, else raise error A; 2.2
HOOK_0015     = 0x0015  ; JP nnnn patched by the RST 18h interpreter; 2.2
RST18_OPS     = 0x0018  ; BASIC threaded-code interpreter (JP F7DBh); 2.2
SYSCALL_A     = 0x001B  ; LD (001Fh),A / RST 30h / DB code / RET: system call with code in A; 2.2
SYSCALL_AGAIN = 0x001E  ; RST 30h with the code stored last time; 2.2
SYSCALL_CODE  = 0x001F  ; function-code byte of the RAM system call; 2.2
USRTAB        = 0x0021  ; EXT statement address table (14 bytes); 2.2
OS_ENTRY      = 0x0030  ; RST 30h: JP INFUNC; copied from EXT E269h at boot; 2.2
IT_ENTRY      = 0x0038  ; IRQ: PUSH AF / OUT (2),70h / JP C405h; 2.2
CARD_TABLE0   = 0x0040  ; card 0: name length, name (<= 6), unit, 40-byte buffer at +8; 2.2
CARD_BUF0     = 0x0048  ; IX for card-0 handlers (EXT E1CCh); 2.2
CARD_TABLE1   = 0x0070
CARD_BUF1     = 0x0078
CARD_TABLE2   = 0x00A0
CARD_BUF2     = 0x00A8
CARD_TABLE3   = 0x00D0
CARD_BUF3     = 0x00D8
SCREEN_ASCII  = 0x0100  ; ASCII copy of the screen, 64 x 25 (row 25 unused by the editor)
HOOK_0725     = 0x0725  ; 3-byte RAM hooks, filled with RET on cold start (SYS C2E2h); called by PAR_CHOUT; 2.2
HOOK_0728     = 0x0728  ; called by the RS-232 driver (EXT E36Eh); 2.2
HOOK_072B     = 0x072B  ; JP REBOOT_RAM on cold start; 2.2
HOOK_072E     = 0x072E  ; called by BASIC (F359h); 2.2
HOOK_0731     = 0x0731  ; called by BASIC (DD25h); 2.2
REBOOT_RAM    = 0x0734  ; DI / OUT (2),70h / JP C21Ch, copied from SYS C338h; 2.2
USER_CHARS    = 0x0740  ; user character matrices, codes 128-223, 10 bytes each
IN_TABLE      = 0x0B00  ; class -> input device (8 bytes); default FF 01 02 FF FF 05 06 FF; 2.2
OUT_TABLE     = 0x0B08  ; class -> output device (8 bytes); default 00 FF 02 FF 04 05 06 FF; 2.2
INT_DES       = 0x0B10  ; devices served by the cursor IRQ; 2.2
PORT03        = 0x0B11  ; mirror of port 03h; 2.2
PORT05        = 0x0B12  ; mirror of port 05h; 2.2
PORT06        = 0x0B13  ; mirror of port 06h; 2.2
SND_ACTIVE    = 0x0B14  ; FF: a tone is playing; 2.2
SND_IRQ       = 0x0B15  ; FF: a new TONE_SET interrupts the running tone; 2.2
STOP_FLAG     = 0x0B16  ; FF: CTRL+ESC pressed; 2.2
ST_LIMIT      = 0x0B17  ; stack floor for FILL (2 bytes); 2.2
HI_MEM        = 0x0B19  ; highest usable RAM address (2 bytes); boot sets 7FFFh or BFFFh; 2.2
P3RAM         = 0x0B1B  ; 00/FF: U3 RAM good/bad (boot test result); 2.2
EX_DEF        = 0x0B1C  ; expansion-card default assignment; 2.2
INTINC        = 0x0B1D  ; IRQ counter, 20 ms (2 bytes); 2.2
IRQ_STAT      = 0x0B1F  ; card IRQ enable; 2.2
INT_FLAG      = 0x0B20  ; IRQ service in progress; 2.2
WARM_FLAG     = 0x0B21  ; FF: warm reset in progress; 2.2
COLD_FLAG     = 0x0B22  ; FF: warm reset disabled; 2.2
INFUNC        = 0x0B23  ; system-call entry stub (20 bytes), copied from EXT E279h; 2.2
OUTFUNC       = 0x0B37  ; system-call exit stub (10 bytes); 2.2
INT_EXIT      = 0x0B41  ; IRQ exit stub (8 bytes); 2.2
STACKT        = 0x0B49  ; temporary stack-pointer store (2 bytes)
L_MODE        = 0x0B4B  ; line-crossing mode; 2.2
L_STYLE       = 0x0B4C  ; line style; 2.2
INK           = 0x0B4D  ; 2.2
PAPER         = 0x0B4E  ; 2.2
BORDER        = 0x0B4F  ; written to port 00h by the IRQ handler; 2.2
V_FLAG        = 0x0B50  ; character overwrite flag; 2.2
PICTURE       = 0x0B51  ; keyboard matrix scan, 10 bytes; 2.2
OLDPICT       = 0x0B5B  ; previous scan, 10 bytes; 2.2
DELAY_KEY     = 0x0B65  ; auto-repeat delay, 20 ms units; 2.2
LOCK_KEY      = 0x0B66  ; b0 CAPS, b1 SHIFT, b3 ALT lock; 2.2
RATE_KEY      = 0x0B67  ; auto-repeat rate, 20 ms units; 2.2
HOLD_DIS      = 0x0B68  ; FF: CTRL+P has no effect; 2.2
BAUD          = 0x0B69  ; RS-232 speed index 0-8 (110-19200); 2.2
FORMAT        = 0x0B6A  ; USART mode byte; 2.2
BUFFER        = 0x0B6B  ; tape: 0 unbuffered / else buffered file; 2.2
REMRED        = 0x0B6C  ; tape motor selection; 2.2
PROTECT       = 0x0B6D  ; tape: copy protection; 2.2
EOF           = 0x0B6E  ; tape: end of file; 2.2
MUDDLE        = 0x0B6F  ; tape CRC seed (2 bytes); 2.2
SER_OK        = 0x0B71  ; 00/FF: sound clock suits the serial line; 2.2
VID_WORK      = 0x0B72  ; video workspace (15 bytes)
IO_WORK       = 0x0B81  ; I/O workspace (100 bytes)
KBD_WORK      = 0x0BE5  ; keyboard workspace (10 bytes); 2.2
SND_WORK      = 0x0BEF  ; sound workspace (1 byte); 2.2
CAS_WORK      = 0x0BF0  ; cassette workspace (600 bytes); 2.2
ED_WORK       = 0x0E48  ; editor workspace (80 bytes); 2.2
PROGID        = 0x0E98  ; program identifier "TV COMPUTER BASIC" (20 bytes, from 1.3); 2.2
SYS_STACK     = 0x0EAC  ; system stack area, 2048 bytes; SP starts at 16ACh; 2.2
BAS_VERSION   = 0x0EB7  ; 21h / 22h written by SYS 2.x boot (C2C5h); not in [OS]
BASIC_WORK    = 0x16AC  ; BASIC workspace (835 bytes); 2.2
BAS_NEW       = 0x1703  ; FF: NEW in command mode; 2.2
BAS_AUTO      = 0x1707  ; autostart; 2.2
BAS_TYPE      = 0x1708  ; type of the current symbol-table entry
BAS_START     = 0x170C  ; start of the current BASIC line (2 bytes); 2.2
BAS_IP        = 0x1718  ; RST 18h bytecode pointer (2 bytes); 2.2, not in [OS]
BAS_VLOMEM    = 0x1720  ; start of the BASIC area (2 bytes); 2.2
BAS_TEXT      = 0x1722  ; start of the BASIC program (2 bytes); 2.2
BAS_CHAIN     = 0x1724  ; last symbol-table entry (2 bytes); 2.2
BAS_TOP       = 0x1726  ; next free symbol-table byte (2 bytes); 2.2
BAS_COMMAND   = 0x1732  ; current statement line buffer (255 bytes)
BAS_BUFFER    = 0x1831  ; INPUT buffer (255 bytes); 2.2
BAS_X         = 0x19C0  ; floating-point register X (7 bytes); 2.2
BAS_Y         = 0x19C7  ; floating-point register Y (7 bytes); 2.2
BAS_FILENAME  = 0x19CE  ; default file name for LOAD/SAVE/OPEN (17 bytes); 2.2
BASIC_AREA    = 0x19EF  ; BASIC program area starts here; 2.2
